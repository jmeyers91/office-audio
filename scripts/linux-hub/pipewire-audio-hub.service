[Unit]
Description=office-audio network receiver hub (Roc + VBAN)
# Ordering matters. These receivers need a sink to exist before they start,
# which means after the session manager, not just after pipewire itself.
After=pipewire.service wireplumber.service
Wants=wireplumber.service
BindsTo=pipewire.service

[Service]
Type=simple
ExecStart=/usr/bin/pipewire -c /etc/pipewire/audio-hub.conf
Restart=always
RestartSec=2
Slice=session.slice

[Install]
WantedBy=default.target
